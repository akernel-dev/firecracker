# Immutable source inputs for the opt-in PVM guest bundle. The VMM version
# remains owned by runtime-versions.env; the host kernel is not packaged.
# This guest source is distinct from the host-only pvm-6.12-host-oot branch.
# Strict TSC is the default; this fork includes the effective-command-line fix.
GUEST_KERNEL_VERSION=6.12
