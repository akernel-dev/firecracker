# AKernel requires EROFS for read-only root and filesystem block devices.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
# CONFIG_EROFS_FS_ZIP_LZMA is not set

# Virtio-fs is built in so the initramfs agent can mount the read-only
# sandbox filesystem before switching root. DAX is deliberately disabled:
# Firecracker exposes no virtio-fs shared-memory window.
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
# CONFIG_FUSE_DAX is not set
# AKernel guests run agent toolchains (codex CLI's bubblewrap sandbox,
# container runtimes) that create user namespaces. The Amazon Linux
# microvm kernel may silently drop CONFIG_USER_NS during olddefconfig
# despite the base config setting it, so force it and disable SELinux
# (a suspicious dependency that could interact with namespace creation).
CONFIG_USER_NS=y
CONFIG_SECURITY_SELINUX=n

# Container networking tools backed by nftables create inet-family chains and
# use family-specific FIB, redirect, and reject expressions.
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y
